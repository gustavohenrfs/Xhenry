# Copie para .env na raiz do projeto. Não commite o .env.
APP_ENV=development
ECHO_SQL=false

# Render e VPS: PostgreSQL. Se omitir, o app usa data/suzana.db.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Bearer do app no developer portal do X. Só para /api/check (saúde da conta).
X_BEARER_TOKEN=

# Obrigatória para /api/login. Não cole o valor no chat.
# SECRET_KEY=

# Endereço público do painel, usado no link de "Esqueceu a senha?" enviado ao Telegram.
# Atrás do nginx é obrigatório; sem ele o link sai com o host da requisição (ex.: 127.0.0.1).
# PUBLIC_URL=https://painel.seudominio.com

# Vigia em segundo plano (app/watchdog.py). WATCHDOG=off desliga.
# ROBO_SILENCE_MIN: avisa no Telegram se o robo.py ficar esse tempo sem coletar (padrão 15).
# AUTO_CHECK_MINUTES: verifica a saúde (Ghost/Search Ban) de cada conta nesse intervalo.
#   0 ou ausente = desligado. Gasta cota da API do X: 3 chamadas por conta por verificação.
# WATCHDOG=on
# ROBO_SILENCE_MIN=15
# AUTO_CHECK_MINUTES=0

# Backup diário (scripts/backup.sh, no cron do VPS). Avisa no Telegram se falhar.
# BACKUP_DIR=/var/backups/xhenry
# BACKUP_KEEP_DAYS=14

# Robô no VPS (robo.py)
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=

# Cadastro em /api/register. Ausente ou false: retorna 403. Ligue (true) só para criar uma conta e desligue depois.
ALLOW_REGISTRATION=false
