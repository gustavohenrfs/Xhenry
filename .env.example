# Copie para .env na raiz do projeto. Não commite o .env.
APP_ENV=development
ECHO_SQL=false

# Render e VPS: PostgreSQL. Se omitir, o app usa data/suzana.db.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Bearer do app no developer portal do X. Só para /api/check (saúde da conta) do admin;
# os outros usuários colam o deles em Configurações.
X_BEARER_TOKEN=

# Multiusuário: o único admin (aprova quem entra e controla o robô).
# ADMIN_EMAIL=henrfs@proton.me

# Leitura das contas dos outros usuários pelo Apify (cada um cola o próprio token em Configurações).
# APIFY_ACTOR: ator que lê as timelines (padrão apidojo~tweet-scraper).
# APIFY_INTERVAL_MIN: cada conta é lida no máximo nesse intervalo, salvo "Atualizar dados" (padrão 60).
# APIFY_ACTOR=apidojo~tweet-scraper
# APIFY_INTERVAL_MIN=60

# Obrigatória para /api/login. Não cole o valor no chat.
# SECRET_KEY=

# Endereço público do painel, usado no link de "Esqueceu a senha?" enviado ao Telegram.
# Atrás do nginx é obrigatório; sem ele o link sai com o host da requisição (ex.: 127.0.0.1).
# PUBLIC_URL=https://painel.seudominio.com

# Vigia em segundo plano (app/watchdog.py). WATCHDOG=off desliga.
# ROBO_SILENCE_MIN: avisa no Telegram se o robo.py ficar esse tempo sem coletar (padrão 15).
# AUTO_CHECK_MINUTES: verifica a saúde (Ghost/Search Ban) de cada conta nesse intervalo.
#   0 ou ausente = desligado. Gasta cota da API do X: 3 chamadas por conta por verificação.
# WATCHDOG=on
# RADAR=off desliga a leitura das fontes do Radar de trend (X Brasil, Google Trends, Notícias, Wikipédia).
# RADAR=on
# ROBO_SILENCE_MIN=15
# AUTO_CHECK_MINUTES=0

# Backup diário (scripts/backup.sh, no cron do VPS). Avisa no Telegram se falhar.
# BACKUP_DIR=/var/backups/xhenry
# BACKUP_KEEP_DAYS=14

# Telegram: um bot só para o painel, o robo.py e o backup (TELEGRAM_BOT_TOKEN também vale).
# Alertas e o "Esqueceu a senha?" dependem dele.
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=

# Cadastro em /api/register sem convite. Ausente ou false: retorna 403 (o normal é entrar pelo link de
# convite da aba Usuários). Ligue (true) só numa emergência para criar o admin e desligue depois.
ALLOW_REGISTRATION=false

# Web Push do sininho: a chave é gerada sozinha no primeiro uso e fica no banco.
# Só preencha para fixar outra (base64url da chave privada P-256).
# VAPID_PRIVATE_KEY=
