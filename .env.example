# Copie para .env na raiz do projeto. Não commite o .env.
APP_ENV=development
ECHO_SQL=false

# Opcional. Se omitir, o app usa data/suzana.db ao lado do main.py.
# DATABASE_URL=sqlite:///C:/Users/henrf/Documents/xhenry/data/suzana.db

# Bearer do app no developer portal do X. Sem isso o painel abre, mas /api/check não chama a API.
# Não use senha, cookie, nem cole o token no chat.
X_BEARER_TOKEN=

# Obrigatória para /api/login. Não cole o valor no chat.
# SECRET_KEY=
